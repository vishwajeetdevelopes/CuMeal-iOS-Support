<!doctype html>
<html lang="en">

<head>

  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>CuMeal - CU Mess Menu</title>

  <meta
    name="description"
    content="CuMeal - CU Mess Menu. Check today's and tomorrow's CU mess menu and mess timings in one simple app."
  >

  <meta
    name="theme-color"
    content="#1d3527"
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap"
    rel="stylesheet"
  >


  <style>

    :root {

      --bg: #f7f8f3;
      --surface: #ffffff;
      --surface-soft: #eef2e9;

      --green-950: #15261c;
      --green-900: #1d3527;
      --green-800: #274a34;
      --green-700: #356044;

      --green-100: #e5eee7;
      --green-50: #f1f6f1;

      --gold: #d49a3a;
      --gold-light: #e8c47e;
      --gold-soft: #f8ecd6;

      --text: #1d251f;
      --text-soft: #657066;
      --text-muted: #8a938b;

      --border: #e2e7df;

      --shadow-sm:
        0 5px 18px rgba(24, 43, 31, .05);

      --shadow-md:
        0 16px 45px rgba(24, 43, 31, .10);

      --shadow-lg:
        0 30px 80px rgba(24, 43, 31, .14);

      --radius-sm: 10px;
      --radius-md: 18px;
      --radius-lg: 28px;

      --max-width: 1180px;

    }


    /* =========================
       RESET
    ========================= */

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {

      margin: 0;

      background: var(--bg);

      color: var(--text);

      font-family:
        "DM Sans",
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

      font-size: 16px;

      line-height: 1.7;

      -webkit-font-smoothing: antialiased;

      text-rendering: optimizeLegibility;

    }

    a {
      color: inherit;
    }

    button {
      font: inherit;
    }


    /* =========================
       HEADER
    ========================= */

    .header {

      position: sticky;

      top: 0;

      z-index: 100;

      background:
        rgba(247, 248, 243, .90);

      backdrop-filter: blur(18px);

      -webkit-backdrop-filter: blur(18px);

      border-bottom:
        1px solid rgba(226, 231, 223, .85);

    }

    .header-inner {

      max-width: var(--max-width);

      height: 76px;

      margin: auto;

      padding: 0 28px;

      display: flex;

      align-items: center;

      justify-content: space-between;

    }


    /* =========================
       BRAND
    ========================= */

    .brand {

      display: flex;

      align-items: center;

      gap: 12px;

      text-decoration: none;

    }

    .brand-icon {

      width: 40px;
      height: 40px;

      display: grid;

      place-items: center;

      background: var(--green-900);

      color: #fff;

      border-radius: 12px;

      font-size: 18px;

      font-weight: 700;

      box-shadow:
        0 5px 15px rgba(29, 53, 39, .18);

    }

    .brand-text {

      display: flex;

      flex-direction: column;

      line-height: 1.1;

    }

    .brand-name {

      color: var(--green-900);

      font-size: 17px;

      font-weight: 700;

    }

    .brand-subtitle {

      margin-top: 4px;

      color: var(--text-muted);

      font-size: 11px;

      font-weight: 500;

      letter-spacing: .04em;

    }


    /* =========================
       NAV
    ========================= */

    .nav {

      display: flex;

      align-items: center;

      gap: 7px;

    }

    .nav a {

      padding: 8px 12px;

      color: var(--text-soft);

      text-decoration: none;

      font-size: 13px;

      font-weight: 500;

      border-radius: 9px;

      transition:
        color .2s ease,
        background .2s ease;

    }

    .nav a:hover {

      background: var(--green-50);

      color: var(--green-800);

    }

    .nav .nav-cta {

      margin-left: 7px;

      padding:
        9px 15px;

      background: var(--green-900);

      color: white;

      border-radius: 10px;

      font-weight: 600;

    }

    .nav .nav-cta:hover {

      background: var(--green-800);

      color: white;

    }


    /* =========================
       HERO
    ========================= */

    .hero {

      position: relative;

      overflow: hidden;

      border-bottom:
        1px solid var(--border);

      background:

        radial-gradient(
          circle at 85% 18%,
          rgba(212, 154, 58, .14),
          transparent 27%
        ),

        radial-gradient(
          circle at 8% 90%,
          rgba(53, 96, 68, .11),
          transparent 30%
        );

    }

    .hero-inner {

      max-width: var(--max-width);

      min-height: 650px;

      margin: auto;

      padding:
        75px 28px
        85px;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        420px;

      gap: 75px;

      align-items: center;

    }


    /* =========================
       HERO COPY
    ========================= */

    .eyebrow {

      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding:
        7px 12px;

      background: var(--green-50);

      border:
        1px solid var(--green-100);

      border-radius: 100px;

      color: var(--green-800);

      font-size: 12px;

      font-weight: 700;

      letter-spacing: .04em;

      text-transform: uppercase;

    }

    .eyebrow-dot {

      width: 7px;
      height: 7px;

      background: var(--gold);

      border-radius: 50%;

    }

    .hero h1 {

      max-width: 720px;

      margin:
        22px 0
        20px;

      color: var(--green-950);

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        clamp(48px, 6vw, 76px);

      font-weight: 500;

      letter-spacing: -.05em;

      line-height: 1.01;

    }

    .hero h1 span {

      color: var(--green-700);

    }

    .hero-description {

      max-width: 610px;

      margin: 0;

      color: var(--text-soft);

      font-size: 18px;

      line-height: 1.75;

    }


    /* =========================
       HERO BUTTONS
    ========================= */

    .hero-actions {

      display: flex;

      flex-wrap: wrap;

      gap: 11px;

      margin-top: 31px;

    }

    .button {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 9px;

      padding:
        12px 18px;

      border-radius: 11px;

      text-decoration: none;

      font-size: 14px;

      font-weight: 700;

      transition:
        transform .2s ease,
        background .2s ease,
        border-color .2s ease;

    }

    .button:hover {

      transform: translateY(-2px);

    }

    .button-primary {

      background: var(--green-900);

      color: white;

      box-shadow:
        0 8px 20px rgba(29, 53, 39, .15);

    }

    .button-primary:hover {

      background: var(--green-800);

    }

    .button-secondary {

      background: white;

      color: var(--green-800);

      border:
        1px solid var(--border);

    }

    .button-secondary:hover {

      border-color:
        var(--green-100);

      background:
        var(--green-50);

    }


    /* =========================
       TRUST
    ========================= */

    .hero-trust {

      display: flex;

      flex-wrap: wrap;

      gap: 18px;

      margin-top: 30px;

      color: var(--text-muted);

      font-size: 12px;

    }

    .hero-trust span {

      display: flex;

      align-items: center;

      gap: 6px;

    }

    .hero-trust strong {

      color: var(--green-800);

    }


    /* =========================
       APP MOCKUP
    ========================= */

    .phone-area {

      position: relative;

      display: flex;

      justify-content: center;

    }

    .phone-glow {

      position: absolute;

      width: 370px;
      height: 370px;

      background:
        radial-gradient(
          circle,
          rgba(53, 96, 68, .15),
          transparent 68%
        );

      filter: blur(3px);

    }

    .phone {

      position: relative;

      width: 290px;

      padding: 10px;

      background:
        #111711;

      border-radius: 40px;

      box-shadow:
        0 30px 70px
        rgba(21, 38, 28, .25);

      transform:
        rotate(2deg);

    }

    .phone-screen {

      overflow: hidden;

      background:
        #f7f8f3;

      border-radius: 31px;

    }

    .phone-notch {

      position: absolute;

      z-index: 5;

      top: 16px;

      left: 50%;

      transform: translateX(-50%);

      width: 95px;

      height: 25px;

      background: #111711;

      border-radius: 0 0 17px 17px;

    }


    /* Mock app */

    .app-top {

      padding:
        45px 18px
        16px;

      background: var(--green-900);

      color: white;

    }

    .app-small {

      margin-bottom: 4px;

      color: #b9c8bb;

      font-size: 10px;

    }

    .app-title {

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size: 25px;

      line-height: 1.1;

    }

    .app-date {

      margin-top: 5px;

      color: #b9c8bb;

      font-size: 10px;

    }

    .app-content {

      padding: 14px;

    }

    .meal-card {

      margin-bottom: 9px;

      padding: 12px;

      background: white;

      border:
        1px solid #e4e8e1;

      border-radius: 12px;

      box-shadow:
        0 3px 10px
        rgba(20, 40, 28, .04);

    }

    .meal-name {

      margin-bottom: 3px;

      color: var(--green-900);

      font-size: 12px;

      font-weight: 700;

    }

    .meal-food {

      color: var(--text-soft);

      font-size: 9px;

      line-height: 1.5;

    }

    .meal-time {

      margin-top: 7px;

      color: var(--gold);

      font-size: 8px;

      font-weight: 700;

    }

    .app-bottom {

      display: flex;

      justify-content: space-around;

      padding:
        12px 10px;

      background: white;

      border-top:
        1px solid #e5e9e4;

      color: var(--text-muted);

      font-size: 8px;

    }

    .app-bottom .active {

      color: var(--green-800);

      font-weight: 700;

    }


    /* =========================
       SECTION COMMON
    ========================= */

    .section {

      max-width: var(--max-width);

      margin: auto;

      padding:
        100px 28px;

    }

    .section-heading {

      max-width: 680px;

      margin-bottom: 45px;

    }

    .section-label {

      margin: 0 0 8px;

      color: var(--gold);

      font-size: 11px;

      font-weight: 700;

      letter-spacing: .11em;

      text-transform: uppercase;

    }

    .section-heading h2 {

      margin: 0;

      color: var(--green-950);

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        clamp(32px, 4vw, 45px);

      font-weight: 500;

      letter-spacing: -.035em;

      line-height: 1.15;

    }

    .section-heading p {

      margin:
        13px 0 0;

      color: var(--text-soft);

      font-size: 16px;

    }


    /* =========================
       FEATURES
    ========================= */

    .features {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 16px;

    }

    .feature {

      padding: 27px;

      background: white;

      border:
        1px solid var(--border);

      border-radius: var(--radius-md);

      box-shadow:
        var(--shadow-sm);

      transition:
        transform .2s ease,
        box-shadow .2s ease;

    }

    .feature:hover {

      transform:
        translateY(-4px);

      box-shadow:
        var(--shadow-md);

    }

    .feature-icon {

      width: 43px;
      height: 43px;

      display: grid;

      place-items: center;

      margin-bottom: 21px;

      background:
        var(--gold-soft);

      color:
        #9b691e;

      border-radius: 12px;

      font-size: 14px;

      font-weight: 700;

    }

    .feature h3 {

      margin:
        0 0 8px;

      color: var(--green-950);

      font-size: 17px;

      font-weight: 700;

    }

    .feature p {

      margin: 0;

      color: var(--text-soft);

      font-size: 14px;

      line-height: 1.7;

    }


    /* =========================
       DARK SECTION
    ========================= */

    .dark-section {

      background:
        var(--green-950);

      color: white;

    }

    .dark-inner {

      max-width: var(--max-width);

      margin: auto;

      padding:
        100px 28px;

    }

    .dark-heading {

      max-width: 680px;

      margin-bottom: 50px;

    }

    .dark-heading .section-label {

      color: var(--gold-light);

    }

    .dark-heading h2 {

      margin: 0;

      color: white;

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        clamp(32px, 4vw, 45px);

      font-weight: 500;

      letter-spacing: -.035em;

      line-height: 1.15;

    }

    .dark-heading p {

      margin:
        14px 0 0;

      color: #aebdb1;

      font-size: 16px;

    }


    /* =========================
       HOW IT WORKS
    ========================= */

    .steps {

      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 18px;

    }

    .step {

      padding: 27px;

      background:
        rgba(255,255,255,.055);

      border:
        1px solid rgba(255,255,255,.09);

      border-radius:
        var(--radius-md);

    }

    .step-number {

      color:
        var(--gold-light);

      font-size: 12px;

      font-weight: 700;

      letter-spacing: .08em;

    }

    .step h3 {

      margin:
        17px 0 8px;

      color: white;

      font-size: 17px;

    }

    .step p {

      margin: 0;

      color: #aebdb1;

      font-size: 14px;

      line-height: 1.7;

    }


    /* =========================
       PRIVACY
    ========================= */

    .privacy-grid {

      display: grid;

      grid-template-columns:
        1.1fr .9fr;

      gap: 55px;

      align-items: center;

    }

    .privacy-copy h2 {

      margin: 0 0 15px;

      color: var(--green-950);

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        clamp(32px, 4vw, 45px);

      font-weight: 500;

      letter-spacing: -.035em;

      line-height: 1.15;

    }

    .privacy-copy p {

      margin: 0 0 20px;

      color: var(--text-soft);

      font-size: 15px;

    }

    .privacy-list {

      display: flex;

      flex-direction: column;

      gap: 11px;

    }

    .privacy-item {

      display: flex;

      align-items: center;

      gap: 11px;

      color: var(--green-800);

      font-size: 14px;

      font-weight: 600;

    }

    .privacy-check {

      width: 25px;
      height: 25px;

      display: grid;

      place-items: center;

      flex-shrink: 0;

      background:
        var(--green-50);

      color:
        var(--green-800);

      border:
        1px solid var(--green-100);

      border-radius: 8px;

      font-size: 11px;

      font-weight: 700;

    }


    /* =========================
       PRIVACY CARD
    ========================= */

    .privacy-card {

      padding: 32px;

      background:
        var(--green-50);

      border:
        1px solid var(--green-100);

      border-radius:
        var(--radius-lg);

    }

    .privacy-card-icon {

      width: 48px;
      height: 48px;

      display: grid;

      place-items: center;

      margin-bottom: 20px;

      background:
        var(--green-900);

      color: white;

      border-radius: 14px;

      font-size: 18px;

      font-weight: 700;

    }

    .privacy-card h3 {

      margin:
        0 0 8px;

      color: var(--green-950);

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size: 25px;

      font-weight: 500;

    }

    .privacy-card p {

      margin: 0 0 20px;

      color: var(--text-soft);

      font-size: 14px;

    }


    /* =========================
       FINAL CTA
    ========================= */

    .cta {

      padding:
        0 28px
        100px;

    }

    .cta-card {

      max-width:
        var(--max-width);

      margin: auto;

      padding:
        65px 55px;

      text-align: center;

      background:

        radial-gradient(
          circle at 10% 10%,
          rgba(212,154,58,.12),
          transparent 30%
        ),

        var(--green-900);

      color: white;

      border-radius:
        var(--radius-lg);

      box-shadow:
        var(--shadow-lg);

    }

    .cta-card h2 {

      max-width: 700px;

      margin:
        0 auto 13px;

      color: white;

      font-family:
        "Playfair Display",
        Georgia,
        serif;

      font-size:
        clamp(32px, 4vw, 48px);

      font-weight: 500;

      letter-spacing: -.035em;

      line-height: 1.12;

    }

    .cta-card p {

      max-width: 560px;

      margin:
        0 auto 27px;

      color: #b9c8bb;

      font-size: 15px;

    }

    .cta-button {

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 9px;

      padding:
        13px 19px;

      background:
        var(--gold);

      color:
        var(--green-950);

      border-radius:
        11px;

      text-decoration: none;

      font-size: 14px;

      font-weight: 700;

      transition:
        transform .2s ease,
        background .2s ease;

    }

    .cta-button:hover {

      background:
        var(--gold-light);

      transform:
        translateY(-2px);

    }


    /* =========================
       FOOTER
    ========================= */

    .footer {

      background:
        var(--green-950);

      color: white;

    }

    .footer-inner {

      max-width:
        var(--max-width);

      margin: auto;

      padding:
        45px 28px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 30px;

    }

    .footer-brand {

      display: flex;

      align-items: center;

      gap: 10px;

    }

    .footer-icon {

      width: 34px;
      height: 34px;

      display: grid;

      place-items: center;

      background:
        rgba(255,255,255,.1);

      border-radius:
        9px;

      font-size: 14px;

      font-weight: 700;

    }

    .footer-brand-text {

      display: flex;

      flex-direction: column;

      line-height: 1.25;

    }

    .footer-brand-name {

      color: white;

      font-size: 14px;

      font-weight: 600;

    }

    .footer-brand-subtitle {

      margin-top: 2px;

      color: #8fa094;

      font-size: 11px;

    }

    .footer-links {

      display: flex;

      align-items: center;

      gap: 18px;

    }

    .footer-links a {

      color: #aebdb1;

      text-decoration: none;

      font-size: 12px;

    }

    .footer-links a:hover {

      color: white;

    }


    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 900px) {

      .hero-inner {

        grid-template-columns: 1fr;

        gap: 50px;

        text-align: center;

      }

      .hero-description {

        margin-left: auto;
        margin-right: auto;
      }

      .hero-actions {

        justify-content: center;
      }

      .hero-trust {

        justify-content: center;
      }

      .phone-area {

        order: -1;
      }

      .phone {

        width: 270px;
      }

      .features {

        grid-template-columns: 1fr 1fr;

      }

      .steps {

        grid-template-columns: 1fr;

      }

      .privacy-grid {

        grid-template-columns: 1fr;

      }

    }


    @media (max-width: 650px) {

      .header-inner {

        height: 68px;

        padding:
          0 20px;

      }

      .nav a:not(.nav-cta) {

        display: none;

      }

      .nav .nav-cta {

        margin-left: 0;

      }

      .hero-inner {

        min-height: auto;

        padding:
          50px 20px
          65px;

      }

      .hero h1 {

        font-size: 45px;

      }

      .hero-description {

        font-size: 16px;

      }

      .phone {

        width: 250px;

      }

      .section {

        padding:
          75px 20px;

      }

      .dark-inner {

        padding:
          75px 20px;

      }

      .features {

        grid-template-columns: 1fr;

      }

      .feature {

        padding: 24px;

      }

      .privacy-card {

        padding: 25px;

      }

      .cta {

        padding:
          0 20px
          75px;

      }

      .cta-card {

        padding:
          48px 24px;

      }

      .footer-inner {

        padding:
          32px 20px;

        flex-direction: column;

        align-items: flex-start;

      }

      .footer-links {

        flex-wrap: wrap;

      }

    }


    @media (prefers-reduced-motion: reduce) {

      html {
        scroll-behavior: auto;
      }

      * {
        transition: none !important;
      }

    }

  </style>

</head>


<body>


  <!-- =========================
       HEADER
  ========================= -->

  <header class="header">

    <div class="header-inner">


      <a href="#" class="brand">

        <div class="brand-icon">
          C
        </div>

        <div class="brand-text">

          <span class="brand-name">
            CuMeal
          </span>

          <span class="brand-subtitle">
            CU Mess Menu
          </span>

        </div>

      </a>


      <nav class="nav">

        <a href="#features">
          Features
        </a>

        <a href="#how-it-works">
          How it works
        </a>

        <a href="#privacy">
          Privacy
        </a>

        <a
          href="support.html"
          class="nav-cta"
        >
          Support
        </a>

      </nav>


    </div>

  </header>



  <!-- =========================
       HERO
  ========================= -->

